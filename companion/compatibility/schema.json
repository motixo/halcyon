{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "halcyon-islands-catalog-v1",
  "type": "object",
  "required": [
    "format",
    "version",
    "cohorts"
  ],
  "properties": {
    "format": {
      "const": "halcyon-islands-catalog"
    },
    "version": {
      "const": 1
    },
    "cohorts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "distribution",
          "suite",
          "architecture",
          "packages",
          "processes",
          "payload_sha256",
          "qualification",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "distribution": {
            "type": "string"
          },
          "suite": {
            "type": "string"
          },
          "architecture": {
            "type": "string"
          },
          "packages": {
            "type": "object",
            "minProperties": 4
          },
          "processes": {
            "type": "object",
            "minProperties": 3
          },
          "payload_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "qualification": {
            "enum": [
              "native-session",
              "development",
              "source-only"
            ]
          },
          "evidence": {
            "type": "object",
            "required": [
              "id",
              "image_sha256",
              "scope"
            ]
          },
          "runtime": {
            "type": "object",
            "required": [
              "version",
              "processes",
              "constraints",
              "unmeasured",
              "configuration"
            ],
            "properties": {
              "version": {
                "const": 3
              },
              "processes": {
                "type": "object",
                "minProperties": 3,
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "executable",
                    "sha256",
                    "mapped",
                    "count",
                    "lifecycle"
                  ],
                  "properties": {
                    "lifecycle": {
                      "enum": [
                        "session",
                        "panel-child"
                      ]
                    },
                    "count": {
                      "oneOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 64
                        },
                        {
                          "const": "configured"
                        }
                      ]
                    },
                    "executable": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "mapped": {
                      "type": "object"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "lifecycle": {
                            "const": "panel-child"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "count": {
                            "const": "configured"
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "count": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 64
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "constraints": {
                "type": "object"
              },
              "unmeasured": {
                "const": [
                  "previously-read-resources",
                  "kernel-bytes",
                  "driver-firmware",
                  "anonymous-code"
                ]
              },
              "configuration": {
                "type": "object",
                "required": [
                  "resolver",
                  "max_outputs",
                  "applets"
                ],
                "properties": {
                  "resolver": {
                    "const": "cosmic-panel-ca20ce3-native-v1"
                  },
                  "max_outputs": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 32
                  },
                  "applets": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "required": [
                        "process",
                        "args"
                      ],
                      "properties": {
                        "process": {
                          "type": "string"
                        },
                        "args": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "runtime_compatibility": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "evidence_id",
                "reason"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "evidence_id": {
                  "type": "string"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "qualification": {
                  "const": "native-session"
                }
              }
            },
            "then": {
              "required": [
                "runtime",
                "runtime_compatibility"
              ]
            }
          }
        ]
      }
    }
  },
  "$comment": "bundle_contract.valid_catalog enforces semantic identity, complete packages/processes, digest/mode bindings, evidence scope and duplicate rejection. A native-session row is a reviewed qualification target; detached promotion must validate its exact final package before distribution. No row is shipped yet. Runtime v3 separates prelaunch session dependencies from panel-owned children. The host cannot be a dependency. Equivalent profiles preserve process roles/counts/paths. Prelaunch measurements never establish running readiness. Panel-child counts are configured at launch from qualified desktop Exec bindings and effective COSMIC config; session counts remain fixed. Configuration absence is not a generic missing-process exemption."
}
